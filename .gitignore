__pycache__/
*.pyc
*.log
*.DS_Store
.venv/

# Credentials. .bbc-storage.env holds the ArvanCloud keys the BBC mirror
# uploads with, and webapp.py's HTML is bundled into the APK - so a key that
# reaches this file is a key that reaches a shipped app.
tools/.cache/
.bbc-storage.env

# Machine-specific SDK location, written by Gradle.
android/local.properties

# The release keystore for a real distribution build. Never committed: it and
# its passwords are secrets. The pinned sideload key in android/keystore/ IS
# committed on purpose, so an update can be built from any checkout - a key
# that only exists on one machine is how an update turns into a reinstall.
android/keystore.properties
*.keystore

# Build output.
android/build/
android/app/build/
android/.gradle/

# Generated by app/build.gradle.kts: the offline bundle copies the data files
# on every build. Tracking them duplicated ~3 MB and let the copies drift from
# the sources without anything noticing.
android/app/src/main/assets/www/data/