__pycache__/
*.pyc
*.log
*.DS_Store
.venv/

# Credentials. .bbc-storage.env holds the ArvanCloud keys the BBC mirror
# uploads with, and webapp.py's HTML is bundled into the APK - so a key that
# reaches this file is a key that reaches a shipped app.
tools/.cache/
.bbc-storage.env
# Object-storage keys. Same rule as the BBC keys: anything this file
# holds can end up inside a shipped app, so it never ships.
.arvan-storage.env

# Machine-specific SDK location, written by Gradle.
android/local.properties

# The release keystore for a real distribution build. Never committed: it and
# its passwords are secrets. The pinned sideload key in android/keystore/ IS
# committed on purpose, so an update can be built from any checkout - a key
# that only exists on one machine is how an update turns into a reinstall.
android/keystore.properties
*.keystore

# Build output.
android/build/
android/app/build/
android/.gradle/

# Generated by app/build.gradle.kts: the offline bundle copies the data files
# on every build. Tracking them duplicated ~3 MB and let the copies drift from
# the sources without anything noticing.
android/app/src/main/assets/www/data/
# The same rule for the three folders build_apk_ui.py syncs. Each one was a
# byte-identical copy of the source folder - fonts/, brand/ and nlp/ - held in
# git in parallel with the original, which is a second copy that can only
# drift. CI runs build_apk_ui.py before Gradle, so the bundle is complete in a
# clean checkout.
android/app/src/main/assets/www/fonts/
android/app/src/main/assets/www/brand/
android/app/src/main/assets/www/nlp/
# Node dependencies for the offline grammar analyser. The generated bundle
# (nlp/fluentify-nlp.js) IS committed: CI never runs npm, and the APK build
# copies that file straight into the app.
nlp/node_modules/

# The web dictionary's cache (dictionary_api.py). It is a record of what this
# machine has looked up so far - machine state, not content - so it is rebuilt
# on demand and never committed.
dictionary_cache.json
dictionary_cache.tmp

# The local copy of a child's mission log, written by /api/quest/sync on this
# machine only. The page owns the progress; this is a cache, not content.
quest_sync/

# Screenshots taken while checking a change, and attachments pulled into a
# chat. Both are local working material, not the product.
screenshots/
.cloud-attachments/

# A built APK and one-off screenshots at the repository root. Both are
# produced by a build or a verification run, never by editing anything here;
# the CI artifact and the screenshot that matters to a change live with that
# change, not checked in beside the sources.
/*.apk
/*.png
