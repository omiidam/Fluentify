    {
      "id": "s_ending",
      "icon": "📌",
      "level": "A1",
      "title": {
        "en": "The -s ending",
        "fa": "پسوند «-s»"
      },
      "blurb": {
        "en": "The most common ending in spoken English. It marks plurals, he/she verbs and possessives — and it has exactly three pronunciations.",
        "fa": "پرکاربرداترین پسوند در انگلیسی گفتاری. جمع، فعل سوم‌شخص و ضمایر ملکی را می‌سازد — و فقط سه تلفظ دارد."
      },
      "tip": {
        "en": "Never add a vowel after /s/, /z/ or /ʃ/. \"buses\" is /ˈbjuːzɪz/ — not \"busees\".",
        "fa": "بعد از /s/، /z/ یا /ʃ/ هرگز واک اضافه نکن. «buses» می‌شود /ˈbjuːzɪz/ — نه «بوسیز» با واک اضافه."
      },
      "groups": [
        {
          "name": {
            "en": "The three sounds",
            "fa": "سه صدا"
          },
          "rows": [
            {
              "ip": "/ɪz/",
              "sub": "adds a syllable",
              "say": "watches",
              "fa": "ساعت‌ها — after s, sh, ch, x, z",
              "words": "boxes · dishes · buses · churches · glasses"
            },
            {
              "ip": "/z/",
              "sub": "the default",
              "say": "books",
              "fa": "کتاب‌ها — most other endings",
              "words": "dogs · cars · beds · bags · boys"
            },
            {
              "ip": "/s/",
              "sub": "after unvoiced sounds",
              "say": "cats",
              "fa": "گربه‌ها — after p, t, k, f, th",
              "words": "maps · hats · cakes · leaves · baths"
            }
          ]
        },
        {
          "name": {
            "en": "Where it appears",
            "fa": "کجا می‌آید"
          },
          "rows": [
            {
              "ip": "plural",
