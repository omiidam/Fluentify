{
 "_readme": "Deterministic fixes for error classes the model misses. Applied to the sentence before GEC-BART Base sees it and to its answer, by tools/gec.py - the server is the only runtime that holds a model. They are model-agnostic rules: pronoun case, \"It is me\", \"I wish I was\", have + simple past.",
 "rules": [
  {
   "id": "me_and",
   "cat": "pronoun",
   "pattern": "\\bMe and ([A-Za-z][a-z]+(?: [a-z]+)?)\\b",
   "flags": "",
   "replace": "\\1 and I"
  },
  {
   "id": "him_and_her",
   "cat": "pronoun",
   "pattern": "\\bHim and her\\b",
   "flags": "",
   "replace": "He and she"
  },
  {
   "id": "me_and_him",
   "cat": "pronoun",
   "pattern": "\\bMe and him\\b",
   "flags": "",
   "replace": "He and I"
  },
  {
   "id": "it_is_me",
   "cat": "pronoun",
   "pattern": "\\bIt is me\\b",
   "flags": "",
   "replace": "It is I"
  },
  {
   "id": "wish_were",
   "cat": "conditional",
   "pattern": "\\bI wish I was\\b",
   "flags": "",
   "replace": "I wish I were"
  },
  {
   "id": "possessive_mine",
   "cat": "pronoun",
   "pattern": "\\bis my(\\s*[.!?]?)$",
   "flags": "",
   "replace": "is mine\\1"
  },
  {
   "id": "can_to",
   "cat": "modal",
   "pattern": "\\b(can|must|should|will|would|could|may|might) to\\s+",
   "flags": "gi",
   "replace": "\\1 "
  },
  {
   "id": "more_worse",
   "cat": "comparative",
   "pattern": "\\bmore (worse|better)\\b",
   "flags": "gi",
   "replace": "\\1"
  },
  {
   "id": "most_easiest",
   "cat": "comparative",
   "pattern": "\\bmost (easiest|hardest|best|worst)\\b",
   "flags": "gi",
   "replace": "\\1"
  },
  {
   "id": "didnt_went",
   "cat": "negation",
   "pattern": "\\bdidn't went\\b",
   "flags": "gi",
   "replace": "didn't go"
  },
  {
   "id": "perfect_ate",
   "cat": "tense",
   "pattern": "\\b(has|have|had)\\s+ate\\b",
   "flags": "gi",
   "replace": "\\1 eaten"
  },
  {
   "id": "perfect_went",
