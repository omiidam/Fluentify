<?xml version="1.0" encoding="utf-8"?>
<!-- What the system paints between the tap and the WebView's first frame.
     That window used to be flat paper for as long as the renderer took to
     start - about a second and a half on the test phone - which reads as the
     app hanging before it has begun. The mark is centred in the same paper
     the loading screen uses, so the two are one screen rather than a blank
     and then a card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_paper" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/fox_mark" />
    </item>
</layer-list>
