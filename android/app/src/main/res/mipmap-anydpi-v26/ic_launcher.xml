<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon: paper behind the portrait, cut from the same picture the
     app draws. Both layers are generated by tools/build_brand.py at every
     density - the art is 72dp of this 108dp layer, so the launcher's mask lands
     on the portrait's own edge and the character keeps its margin. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
