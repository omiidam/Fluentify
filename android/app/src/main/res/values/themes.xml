<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is the page's paper colour, not the navy glass the app wore
         before its cream theme: a window background is what the system paints
         until the WebView has a first frame, so any other colour here is a dark
         flash in front of a cream loading screen. The bars are drawn in the
         same paper, with dark icons to match their light background. -->
    <style name="Theme.Fluentify" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#FAF4E8</item>
        <item name="android:navigationBarColor">#FAF4E8</item>
        <item name="android:windowBackground">#FAF4E8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
