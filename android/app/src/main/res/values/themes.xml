<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is the loading card's own backdrop, whichever theme the
         device is in: a window background is what the system paints until the
         WebView has a first frame, so any other colour here is a flash in
         front of the loading screen. The bars are drawn in the same paper,
         with icons that match its lightness. -->
    <style name="Theme.Fluentify" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/launch_chrome</item>
        <item name="android:navigationBarColor">@color/launch_chrome</item>
        <item name="android:windowBackground">@color/launch_paper</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/launch_light_bars</item>
    </style>
</resources>
